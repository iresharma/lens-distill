# Neon (pooled for runtime, unpooled for migrations)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Claude path: auto (default) | direct | openrouter
# auto = probe Anthropic; on usage/spend cap → OpenRouter
# DISTILL_ANTHROPIC_TRANSPORT=auto

# Optional model overrides (direct Anthropic IDs)
# DISTILL_EXTRACT_MODEL=claude-haiku-4-5-20251001
# DISTILL_MERGE_MODEL=claude-sonnet-5
# DISTILL_CONCEPTS_MODEL=claude-opus-5
# DISTILL_EMBED_MODEL=openai/text-embedding-3-small

# OpenRouter model IDs when transport resolves to openrouter
# DISTILL_EXTRACT_MODEL_OR=anthropic/claude-haiku-4.5
# DISTILL_MERGE_MODEL_OR=anthropic/claude-sonnet-5
# DISTILL_CONCEPTS_MODEL_OR=anthropic/claude-opus-5

# OpenTelemetry — SigNoz self-hosted (namespace `iresharma` on the target cluster)
# Local dev: kubectl port-forward svc/otel-collector -n iresharma 4318:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# In-cluster (set via the eventual deployment's env, NOT hardcoded in this repo):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.iresharma.svc.cluster.local:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=lens-distill
# OTEL_SERVICE_NAMESPACE=lens-distill
# OTEL_DEPLOYMENT_ENVIRONMENT=development
# Set true to fully disable OTel export (e.g. local dev without a collector reachable)
# OTEL_SDK_DISABLED=false

# Prometheus pull endpoint (in addition to the OTLP push above) — serves
# GET http://<host>:<port><endpoint> for Prometheus to scrape directly.
# OTEL_PROMETHEUS_HOST=0.0.0.0
# OTEL_PROMETHEUS_PORT=9464
# OTEL_PROMETHEUS_ENDPOINT=/metrics
# Set true to disable the Prometheus endpoint and keep only the OTLP push path
# OTEL_PROMETHEUS_DISABLED=false
